# Modelo do arquivo de conexão com o banco no Supabase.
#
# 1. Copie este arquivo para supabase.env, aqui mesmo na raiz do projeto.
#    O supabase.env está no .gitignore: ele tem a senha e nunca vai para o GitHub.
# 2. Preencha os valores pedidos a quem administra o Supabase (nunca pelo GitHub).
# 3. Suba a API com backend\subir-api-supabase.ps1.
#
# Os dados ficam no painel do Supabase em "Connect" > "Direct" > "Session pooler".

DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<id-do-projeto>
DB_PASSWORD=<senha-do-banco>
